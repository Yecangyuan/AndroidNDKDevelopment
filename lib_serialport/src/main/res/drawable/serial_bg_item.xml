<?xml version="1.0" encoding="utf-8"?>
<!-- 列表项卡片背景：圆角 + 细描边，按下时换色给出反馈（selector 兼容 API 19，不用 ripple） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/serial_item_bg_pressed" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/serial_item_stroke_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/serial_item_bg" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/serial_item_stroke" />
        </shape>
    </item>
</selector>
