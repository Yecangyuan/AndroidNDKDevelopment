<?xml version="1.0" encoding="utf-8"?>
<!--
  串口设备选择页。
  结构：说明文字 → 波特率输入卡片 → 「可用设备」小节 → 设备列表 / 空状态。
  id 约定（Activity 依赖，改名需同步）：
    btlv            波特率输入框（EditText，TextInputLayout 内）
    til_baud_rate   波特率输入框外壳，用于 setError 内联提示
    lv_devices      设备列表
    tv_empty        空状态（作为 ListView 的 emptyView，必须与 lv_devices 同父容器）
    tv_device_count 设备数量
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_serial_page"
    android:orientation="vertical"
    tools:context=".serialport.SelectSerialPortActivity">

    <!-- 页面说明：标题由 ActionBar 承担，这里只放一句引导语 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/serial_device_subtitle"
        android:textColor="@color/serial_text_secondary"
        android:textSize="13sp" />

    <!-- 波特率输入卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/serial_item_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/serial_item_stroke"
        app:strokeWidth="1dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_baud_rate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:hint="@string/input_baud_rate">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/btlv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="7"
                android:singleLine="true"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 小节标题：色条 + 标题 + 数量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@color/serial_brand_end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/serial_available_devices"
            android:textColor="@color/serial_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_device_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/serial_text_tertiary"
            android:textSize="12sp"
            tools:text="(3)" />
    </LinearLayout>

    <!-- 列表与空状态必须同父容器，setEmptyView 才会生效 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_devices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.3"
                android:contentDescription="@null"
                android:src="@drawable/ic_serial_port" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/no_avaiable_serial_port"
                android:textColor="@color/serial_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/serial_empty_hint"
                android:textColor="@color/serial_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
